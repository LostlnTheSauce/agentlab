# Copy to .env and fill in. Never commit .env.

# --- required
ODDS_API_KEY=
# Optional but recommended: gives the tipsters real judgment (otherwise rule-based fallback).
ANTHROPIC_API_KEY=

# --- money
LAB_UNIT_DOLLARS=1          # 1 unit = $1
LAB_WALLET_DOLLARS=10       # each tipster's real wallet
LAB_MAX_UNITS=2             # max stake per pick
LAB_MAX_REAL_PER_DAY=6      # most real-money picks the CEO will recommend per day

# --- schedule (cron calls `python -m lab tick` every 15 min; these decide what it does)
LAB_TZ=America/Chicago
LAB_SLATE_HOUR=8
LAB_RESCAN_HOURS=12,16

# --- odds budget. Free tier = 500/month -> keep this at ~16. On the $30 plan (20k/month) use ~400.
LAB_DAILY_CREDIT_CAP=16
LAB_MY_BOOKS=bovada          # books you have accounts at; e.g. bovada,lowvig for line shopping
LAB_RECAP_HOUR=22           # nightly results recap (local time; needs NTFY_TOPIC)
LAB_SPORTS=americanfootball_nfl,americanfootball_ncaaf,baseball_mlb,basketball_nba,soccer_epl
LAB_CLOSING_LINES=1         # grab one more price right before kickoff (powers CLV)
LAB_PROPS=0                 # NFL player props for Props Goblin (~4 credits/day)
LAB_AGENT_MEMORY=1          # tipsters see their last 8 graded picks before deciding
LAB_MEETING_HOUR=21         # Sunday board meeting (local time)
LAB_BACKUP_HOUR=3           # nightly database backup (local time)

# --- Claude models (see README for cost)
LAB_TIPSTER_MODEL=claude-opus-5-5
LAB_TIPSTER_EFFORT=low
LAB_CEO_MODEL=claude-opus-5-5
LAB_CEO_EFFORT=medium

# --- phone alerts via the free ntfy app (pick a long random topic name; anyone who knows it can read it)
NTFY_TOPIC=
LAB_PUBLIC_URL=             # e.g. https://lab.yoursite.com (used for alert links and secure cookies)
